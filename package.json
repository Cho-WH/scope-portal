{
  "name": "scope-science-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run validate:content && astro build",
