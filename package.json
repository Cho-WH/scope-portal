    "new:tool": "node scripts/new-tool.mjs"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
