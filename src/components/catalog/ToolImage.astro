---
import type { Tool } from '../../lib/catalog/schema';
interface Props { tool: Tool }
const { tool } = Astro.props;
const image = tool.thumbnail;
---
<div class:list={['tool-image', { 'tool-image-contain': image?.fit === 'contain' }]} data-tool-image>
  {image ? <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /> :
    <div class="image-placeholder" role="img" aria-label={`${tool.name} 대표 이미지 준비 중`}>
      <svg aria-hidden="true" width="30" height="24" viewBox="0 0 30 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="1" y="1" width="28" height="22" rx="3" /><circle cx="9" cy="8" r="2" /><path d="m2 20 8-7 5 4 5-7 8 10" /></svg>
      <span>이미지 준비 중</span>
    </div>}
</div>
<style>
  .tool-image { width: 100%; height: 100%; min-height: 0; overflow: hidden; border-radius: 7px; background: var(--color-mist); }
  img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .tool-image-contain { background: #f4f7f6; }
  .tool-image-contain img { object-fit: contain; }
  .image-placeholder { height: 100%; min-height: 76px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; color: var(--color-muted); font-size: 11px; }
  .image-placeholder svg { opacity: .55; }
</style>
