---
import type { Tool } from '../../lib/catalog/schema';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import PreviewPlaceholder from './PreviewPlaceholder.astro';
interface Props { tools: Tool[] }
const { tools } = Astro.props;
---
{tools.length > 0 && <section class="featured-banner" data-featured aria-label="대표 도구 소개">
  {tools.map((tool, i) => <div class="feature-panel" id={`feature-panel-${tool.id}`} role="tabpanel" aria-labelledby={`feature-tab-${tool.id}`} hidden={i !== 0} data-feature-panel={tool.id}>
    <div class="feature-copy">
      <h2>{tool.featured!.headline}</h2>
      <p class="feature-description">{tool.featured!.description}</p>
      <div class="feature-actions"><ExternalLink href={tool.launchUrl} label={`${tool.name} 실행`} class="button button-primary" /><a class="text-link" href={`/tools/${tool.id}/`}>도구 소개</a></div>
    </div>
    <div class="feature-preview" data-preview-host><PreviewPlaceholder tool={tool} /></div>
  </div>)}
  <div class="feature-tabs" role="tablist" aria-label="대표 도구 선택">
    {tools.map((tool, i) => <button type="button" role="tab" id={`feature-tab-${tool.id}`} aria-controls={`feature-panel-${tool.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-feature-id={tool.id}>
      <span class="label-long">{tool.name}</span><span class="label-short">{tool.featured!.shortLabel}</span>
    </button>)}
    <span class="feature-indicator" data-feature-indicator aria-hidden="true"></span>
  </div>
</section>}
<script>import './featured.ts';</script>
<style>
  .featured-banner { margin: 20px 0 22px; }
  .feature-panel { display: grid; grid-template-columns: 1.05fr .95fr; gap: 42px; align-items: center; min-height: 230px; padding: 4px 0 12px; }
  .feature-copy h2 { font-size: 34px; font-weight: 600; line-height: 1.28; letter-spacing: -1.2px; white-space: pre-line; }
  .feature-description { max-width: 35em; margin-top: 12px; color: var(--color-muted); font-size: 14px; word-break: keep-all; white-space: pre-line; }
  .feature-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; margin-top: 15px; }
  .feature-tabs { position: relative; display: flex; align-items: center; gap: 20px; width: max-content; max-width: 100%; margin-top: 4px; }
  .feature-tabs button { position: relative; min-height: 44px; padding: 10px 2px; font-size: 11px; background: transparent; color: var(--color-muted); white-space: nowrap; }
  .feature-tabs button:hover, .feature-tabs button[aria-selected='true'] { color: var(--color-ink); }
  .feature-tabs:not([data-indicator-ready]) button[aria-selected='true']::after { content: ''; position: absolute; bottom: 3px; left: 2px; right: 2px; height: 2px; background: var(--color-accent); }
  .feature-indicator { position: absolute; left: 0; bottom: 3px; width: 1px; height: 2px; background: var(--color-accent); transform-origin: left; transition: transform 180ms ease; opacity: 0; pointer-events: none; }
  .feature-tabs[data-indicator-ready] .feature-indicator { opacity: 1; }
  .label-short { display: none; }
  @media (max-width: 800px) and (min-width: 680px) { .feature-panel { gap: 24px; } .feature-copy h2 { font-size: 30px; } }
  @media (prefers-reduced-motion: reduce) { .feature-indicator { transition: none; } }
  @media (max-width: 679px) {
    .featured-banner { margin: 16px 0 18px; }
    .feature-tabs { gap: 14px; margin-top: 6px; }
    .feature-tabs button { min-width: 44px; }
    .label-long, .feature-preview { display: none; }
    .label-short { display: inline; }
    .feature-panel { display: block; min-height: 0; padding: 0; }
    .feature-copy h2 { font-size: 27px; line-height: 1.25; letter-spacing: -.8px; }
    .feature-description { font-size: 13px; margin-top: 9px; }
    .feature-actions { margin-top: 12px; gap: 20px; }
  }
</style>
