---
import type { Tool } from '../../lib/catalog/schema';
interface Props { tool: Tool }
const { tool } = Astro.props;
const poster = tool.preview?.poster;
---
<!-- Inert until the desktop media query matches. Mobile does not request the poster. -->
<template data-preview-template>
  <figure class="preview-placeholder" data-preview="placeholder">
    <div class:list={['preview-poster', { 'preview-poster-contain': poster?.fit === 'contain' }]} style={`--preview-x: ${poster?.focalPoint?.x ?? 50}%; --preview-y: ${poster?.focalPoint?.y ?? 50}%;`}>
      {poster ? <img src={poster.src} alt={poster.alt} width={poster.width} height={poster.height} fetchpriority="high" /> : <span class="preview-fallback">{tool.name}</span>}
    </div>
    <figcaption class="sr-only">{tool.name} 정적 소개 이미지</figcaption>
  </figure>
</template>
<style>
  .preview-placeholder { width: 100%; height: 100%; margin: 0; }
  .preview-poster { height: 100%; overflow: hidden; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center;
    mask-image: linear-gradient(to right, transparent, rgb(0 0 0 / .05) 10%, rgb(0 0 0 / .35) 24%, rgb(0 0 0 / .8) 40%, #000 54%, #000 90%, transparent), linear-gradient(to bottom, transparent, #000 13%, #000 80%, transparent);
    mask-composite: intersect;
  }
  .preview-poster img { width: 100%; height: 100%; min-width: 0; min-height: 0; object-fit: cover; object-position: var(--preview-x) var(--preview-y); }
  .preview-poster-contain img { object-fit: contain; }
  .preview-poster-contain { padding-left: 12%; }
  .preview-fallback { color: var(--color-muted); }
</style>
