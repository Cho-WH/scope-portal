---
import type { Tool } from '../../lib/catalog/schema';
interface Props { tool: Tool }
const { tool } = Astro.props;
const poster = tool.preview?.poster;
---
<!-- Inert until the desktop media query matches. Mobile does not request the poster. -->
<template data-preview-template>
  <figure class="preview-placeholder" data-preview="placeholder">
    <div class:list={['preview-poster', { 'preview-poster-contain': poster?.fit === 'contain' }]}>
      {poster ? <img src={poster.src} alt={poster.alt} width={poster.width} height={poster.height} /> : <span class="preview-fallback">{tool.name}</span>}
    </div>
    <figcaption>정적 미리보기 <span>조작 기능 준비 중</span></figcaption>
  </figure>
</template>
<style>
  .preview-placeholder { width: 100%; }
  .preview-poster { height: 166px; overflow: hidden; border-radius: 7px; background: var(--color-mist); display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center; }
  .preview-poster img { width: 100%; height: 100%; min-width: 0; min-height: 0; object-fit: cover; object-position: center; }
  .preview-poster-contain { background: light-dark(#ffffff, #edf2f8); }
  .preview-poster-contain img { object-fit: contain; }
  .preview-fallback { color: var(--color-muted); }
  figcaption { display: flex; justify-content: space-between; gap: 10px; font-size: 11px; color: var(--color-muted); padding-top: 6px; }
</style>
