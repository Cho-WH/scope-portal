---
import PortalLayout from '../../layouts/PortalLayout.astro';
import ResourceList from '../../components/resources/ResourceList.astro';
import { loadCatalog } from '../../lib/catalog/load';
const { resources, tools } = await loadCatalog();
---
<PortalLayout title="수업 자료">
  <header class="resource-heading"><a class="text-link" href="/#tools">실험 도구로 돌아가기</a><h1>수업 자료</h1><p>실험 안내, 활동지와 도구의 다른 언어 버전을 모았습니다.</p></header>
  <ResourceList resources={resources} tools={tools} />
</PortalLayout>
<style>.resource-heading { margin: 18px 0 30px; }.resource-heading h1 { margin-top: 14px; }.resource-heading p { margin-top: 10px; color: var(--color-muted); word-break: keep-all; }</style>
