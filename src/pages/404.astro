---
import PortalLayout from '../layouts/PortalLayout.astro';
---
<PortalLayout title="페이지를 찾을 수 없습니다" noindex><section class="not-found"><h1>페이지를 찾을 수 없어요.</h1><p>주소를 확인하거나 전체 도구 목록에서 다시 찾아보세요.</p><a href="/#tools" class="button button-primary">전체 도구 보기</a></section></PortalLayout>
<style>.not-found { padding: 70px 0; }.not-found p { margin: 16px 0 24px; color: var(--color-muted); }</style>
